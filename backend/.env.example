OLLAMA_URL=http://localhost:11434

# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# Two separate secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_different

# LLM provider: "ollama" or "groq"
LLM_PROVIDER=ollama
# Ollama: e.g. llama3.1 | Groq: e.g. meta-llama/llama-4-scout-17b-16e-instruct
LLM_MODEL=llama3.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=10000
LLM_TEMPERATURE=0.2

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=your_api_key_here
